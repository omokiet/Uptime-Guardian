# Domain / Host (dùng cho Caddy tự động cấp Let's Encrypt HTTPS)
# Ví dụ: uptime.example.com. Nếu chạy local test thì để: localhost
DOMAIN=localhost

# PostgreSQL Production Credentials
POSTGRES_USER=uptime_admin
POSTGRES_PASSWORD=change_this_to_a_strong_password_123
POSTGRES_DB=uptime_guardian_prod

# Redis Production Password
REDIS_PASSWORD=change_this_redis_password_456

# RabbitMQ Production Credentials
RABBITMQ_DEFAULT_USER=uptime_rabbit
RABBITMQ_DEFAULT_PASS=change_this_rabbit_password_789

# API Gateway Security
SECRET_KEY=change_this_to_at_least_32_characters_random_secret_key!

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Grafana Admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password_999
