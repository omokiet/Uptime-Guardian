# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/uptime_guardian
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/uptime_guardian
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=uptime_guardian

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_CHECK_JOBS=check.jobs
RABBITMQ_QUEUE_ALERT_EVENTS=alert.events

# API Gateway Security
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
COOLDOWN_MINUTES=15
CONSECUTIVE_THRESHOLD=3
